{
  "name": "bus-booking-api",
  "version": "1.0.0",
  "private": true,
  "description": "Bus trip and seat reservation API with deployment and operations tooling",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "db": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=22 <26"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "globals": "16.5.0",
    "jest": "29.7.0",
    "supertest": "7.1.4"
  }
}
